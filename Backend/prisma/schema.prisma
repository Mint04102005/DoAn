// ==============================================================================
// PRISMA SCHEMA FOR CURL-CURATOR-AI BACKEND
// Target Database: PostgreSQL
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  USER
  SALON_OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SalonStatus {
  PENDING
  APPROVED
  REJECTED
}

// ------------------------------------------------------------------------------
// MODELS
// ------------------------------------------------------------------------------

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  phone     String?
  avatarUrl String?
  gender    String?
  dob       String?
  address   String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  salons             Salon[]
  bookings           Booking[]
  tryOnHistories     TryOnHistory[]
  recommendationLogs RecommendationLog[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Salon {
  id             Int         @id @default(autoincrement())
  ownerId        Int
  owner          User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  address        String
  phone          String
  operatingHours String?
  images         String[]
  rating         Float       @default(5.0)
  status         SalonStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  bookings       Booking[]

  @@index([ownerId])
  @@index([status])
  @@map("salons")
}

model Hairstyle {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  gender      String
  faceShapes  String[]
  hairType    String?
  imageUrl    String
  tags        String[]
  createdAt   DateTime @default(now())

  // Relations
  tryOnHistories TryOnHistory[]

  @@map("hairstyles")
}

model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  salonId     Int
  salon       Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookingTime DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([salonId])
  @@index([status])
  @@map("bookings")
}

model TryOnHistory {
  id               Int        @id @default(autoincrement())
  userId           Int
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hairstyleId      Int?
  hairstyle        Hairstyle? @relation(fields: [hairstyleId], references: [id], onDelete: SetNull)
  originalImageUrl String
  resultImageUrl   String
  status           String     @default("COMPLETED")
  createdAt        DateTime   @default(now())

  @@index([userId])
  @@map("try_on_histories")
}

model RecommendationLog {
  id                      Int      @id @default(autoincrement())
  userId                  Int
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  faceShapeDetected       String
  preferences             Json
  recommendedHairstyleIds Int[]
  createdAt               DateTime @default(now())

  @@index([userId])
  @@map("recommendation_logs")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  adminId      Int
  admin        User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action       String
  targetEntity String
  details      String?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@map("audit_logs")
}
